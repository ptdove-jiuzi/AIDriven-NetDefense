  "version": 1,
  "metadata": {
    "timestamp": "2026-11-04T08:45:00Z",
    "component": {
      "type": "application",
      "bom-ref": "app:aidn-windows-installer",
      "name": "AIDriven-NetDefense-Setup",
      "version": "0.0.0",
      "description": "Windows installer (PyInstaller --onefile) built from deploy/windows/installer/app. Version label is taken from the release tag at build time; this BOM describes the build inputs, which change only when requirements.txt or the CPython minor does.",
      "licenses": [
        {
          "license": {
            "id": "Apache-2.0"
          }
        }
      ],
      "properties": [
        {
          "name": "aidn:artifact",
          "value": "AIDrivenNetDefense-Setup-<version>.exe"
        },
        {
          "name": "aidn:artifact:scope",
          "value": "win32-x64 only. The Linux .deb and tar.gz are produced by scripts/release/assemble-deb.sh and are outside this BOM."
        }
      ]
    },
    "tools": {
      "components": [
        {
          "type": "application",
          "name": "pip",
          "description": "Resolves and installs deploy/windows/installer/app/requirements.txt into the build host. Version is whatever the runner's CPython ships; not pinned."
        },
        {
          "type": "application",
          "name": "PyInstaller",
          "version": "6.22.3"
        },
        {
          "type": "application",
          "name": "7-Zip",
          "description": "Build-host 7z.exe, used by build_setup.py to create payload.7z and to verify it (-mf=off, plain LZMA2). Not redistributed: no 7z.exe exists in the payload or the installed tree, so 7-Zip's licence imposes no obligation on the artifact. Version is whatever the windows-latest image ships; not pinned."
        },
        {
          "type": "application",
          "name": "cpython",
          "version": "3.13"
        }
      ]
    },
    "properties": [
      {
        "name": "aidn:sbom:why",
        "value": "sbom.cdx.json at the repository root is generated from package-lock.json by cyclonedx-npm --package-lock-only, so it can only ever describe npm components. The Python build chain of the Windows installer is a different artifact with a different lifecycle, and scripts/check-sbom.mjs enforces a bijection between package-lock.json and that file. Adding PyPI components there would break the bijection and make the root SBOM unrebuildable from its documented command; it is therefore recorded here instead, as a second BOM scoped to the installer."
      },
      {
        "name": "aidn:sbom:scope",
        "value": "win_amd64 / CPython 3.13 (cp313). Components with scope=required are present in Setup.exe; scope=excluded components are build-host only and never reach the artifact."
      },
      {
        "name": "aidn:sbom:reproduce",
        "value": "python -m pip download --disable-pip-version-check --only-binary :all: --platform win_amd64 --python-version 3.13 --implementation cp --abi cp313 -r deploy/windows/installer/app/requirements.txt -d wheels  then sha256sum wheels/*.whl and compare with the hashes below and with requirements.lock.txt."
      },
      {
        "name": "aidn:sbom:verify",
        "value": "node -e \"const s=require('./deploy/windows/installer/app/requirements.sbom.cdx.json');const l=require('fs').readFileSync('deploy/windows/installer/app/requirements.lock.txt','utf8');const bad=s.components.filter(c=>c.hashes).filter(c=>!l.includes(c.hashes[0].content));console.log('components',s.components.length,'unmatched',bad.length);if(bad.length)process.exit(1)\""
      },
      {
        "name": "aidn:sbom:revalidate",
        "value": "Required after any change to requirements.txt, to the CPython minor version, or to build_setup.py's hidden imports: re-run aidn:sbom:reproduce, refresh the hashes, and update THIRD_PARTY_NOTICES if a licence changed."
      }
    ]
  },
